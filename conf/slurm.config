// Profil SLURM (Alliance de recherche numérique du Canada : Narval, Béluga, Rorqual...) + Apptainer.
// Remplacer def-XXXXX par ton compte d'allocation (`sacctmgr show assoc user=$USER`).
params {
    slurm_account = 'def-XXXXX'
}

apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = "${System.getenv('SCRATCH') ?: System.getenv('HOME')}/apptainer_cache"
}

process {
    executor       = 'slurm'
    clusterOptions = "--account=${params.slurm_account}"
    resourceLimits = [
        cpus  : 32,
        memory: 180.GB,
        time  : 48.h
    ]
    // STAR sur GRCh38 : ~40 Go pour l'index/l'alignement
    withName: 'STAR_GENOMEGENERATE' { cpus = 16; memory = 64.GB; time = 4.h }
    withName: 'STAR_ALIGN'          { cpus = 16; memory = 48.GB; time = 8.h }
}

executor {
    queueSize       = 20
    submitRateLimit = '10 sec'
    pollInterval    = '1 min'
}

workDir = "${System.getenv('SCRATCH')}/nf_work_airway"
