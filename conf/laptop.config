// Profil portable (sans GPU) : pseudo-alignement Salmon seul, Docker.
// Adapter cpus/memory à ta machine (Docker Desktop/WSL2 doit avoir accès à cette RAM).
docker.enabled = true
docker.runOptions = '-u $(id -u):$(id -g)'

process {
    resourceLimits = [
        cpus  : 6,
        memory: 14.GB,
        time  : 24.h
    ]
    // Indexation Salmon du transcriptome humain : le plus gourmand en mémoire
    withName: 'SALMON_INDEX' {
        cpus   = 4
        memory = 14.GB
    }
    executor = 'local'
}

executor {
    name   = 'local'
    cpus   = 6
    memory = 14.GB
}
